erDiagram
    stations ||--o{ air_quality_readings : "records"
    stations ||--o{ weather_readings : "records"
    wind_directions ||--o{ weather_readings : "classifies"

    stations {
        int station_id PK
        varchar name UK
        varchar station_type
        varchar city
    }
    wind_directions {
        int wind_dir_id PK
        varchar code UK
        varchar description
    }
    air_quality_readings {
        bigint reading_id PK
        int station_id FK
        timestamp ts
        int pm25
    }
    weather_readings {
        bigint reading_id PK
        int station_id FK
        timestamp ts
        numeric dewp
        numeric temp
        numeric pres
        int wind_dir_id FK
        numeric cum_wind_speed
        int cum_snow_hours
        int cum_rain_hours
    }
